<a class="btn btn-link mb-3" href="/affiliates">← Volver a la lista de afiliados</a>

<div class="card">
	<div class="card-body">
		<h2 class="card-title">{{affiliate.firstName}} {{affiliate.lastName}}</h2>
		<p class="card-text">{{affiliate.email}}</p>
		<p class="mt-3"><strong>Tipo de membresía:</strong> <span class="text-primary">{{affiliate.membershipType}}</span></p>
		<a class="btn btn-outline-secondary btn-sm" href="/affiliates/edit/{{affiliate.id}}">Editar</a>
		<!-- Delete trigger button -->
		<button type="button" class="btn btn-outline-danger btn-sm" data-bs-toggle="modal" data-bs-target="#deleteModal">Eliminar</button>

		<!-- Delete confirmation modal -->
		<div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
		  <div class="modal-dialog modal-dialog-centered">
		    <div class="modal-content">
		      <div class="modal-header">
		        <h5 class="modal-title" id="deleteModalLabel">Confirmar eliminación</h5>
		        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
		      </div>
		      <div class="modal-body">
		        ¿Estás seguro que deseas eliminar al afiliado <strong>{{affiliate.firstName}} {{affiliate.lastName}}</strong>?
		      </div>
		      <div class="modal-footer">
		        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
		        <form action="/affiliates/delete/{{affiliate.id}}" method="POST" class="d-inline">
		          <button type="submit" class="btn btn-danger">Eliminar</button>
		        </form>
		      </div>
		    </div>
		  </div>
		</div>
	
	</div>
</div>